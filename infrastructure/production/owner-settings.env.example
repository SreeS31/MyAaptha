# Non-secret deployment choices from the owner's 26 October dependency response.
# Planning template only: endpoints/images/certificates still require provisioning.
MYAAPTHA_DOMAIN=www.myaaptha.com
MYAAPTHA_S3_REGION=ap-south-1
POSTGRES_DB=myaaptha
POSTGRES_USER=myaaptha
POSTGRES_HOST=postgres
POSTGRES_SSLMODE=verify-full
REDIS_HOST=redis
REDIS_TLS=true
DB_POOL_SIZE=10
MYAAPTHA_TURN_URLS=turn:turn.myaaptha.com:3478?transport=udp,turn:turn.myaaptha.com:3478?transport=tcp,turns:turn.myaaptha.com:5349?transport=tcp
MYAAPTHA_CALLS_RELAY_REQUIRED=true
MYAAPTHA_TURN_CREDENTIAL_SECONDS=3600
MYAAPTHA_HEALTH_AI_ENABLED=false
# Do not activate health analysis or change models until provider/quality/consent acceptance.
# Keep provider credentials in secrets/integrations as described in OWNER-SETUP-2026-10-26.md.
