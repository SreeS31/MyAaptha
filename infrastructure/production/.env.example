# Dummy values for planning only. Real production startup rejects placeholders.
MYAAPTHA_DOMAIN=app.example.com
MYAAPTHA_FRONTEND_IMAGE=ghcr.io/OWNER/myaaptha-frontend:VERSION
MYAAPTHA_BACKEND_IMAGE=ghcr.io/OWNER/myaaptha-backend:VERSION
MYAAPTHA_AI_IMAGE=ghcr.io/OWNER/myaaptha-ai-agent:VERSION
POSTGRES_HOST=managed-postgres.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=myaaptha
POSTGRES_USER=myaaptha
POSTGRES_SSLMODE=verify-full
MYAAPTHA_S3_BUCKET=replace-with-private-bucket
MYAAPTHA_S3_REGION=ap-south-1
MYAAPTHA_S3_ENDPOINT=
MYAAPTHA_NOTIFICATION_WEBHOOK_CHANNEL=
MYAAPTHA_NOTIFICATION_WEBHOOK_URL=
# Optional read-only metrics credential. Inject through your secret manager; blank disables it.
MYAAPTHA_METRICS_SCRAPE_TOKEN=

REDIS_HOST=managed-redis.example.internal
REDIS_PORT=6379
REDIS_TLS=true
DB_POOL_SIZE=20
MYAAPTHA_FIELD_ACTIVE_KEY_ID=primary
# Store primary=<Base64 of 32 random bytes> in secrets/field_encryption_keys.
# Store a separate Base64-encoded 32-byte MFA key in secrets/admin_mfa_encryption_key.
# Never commit either secret. Keep old field key IDs available during rotation.
TRUSTED_PROXY_REGEX=REPLACE_WITH_PROXY_ADDRESS_REGEX
